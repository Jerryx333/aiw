#!/usr/bin/env bash
# aiw — aiw 统一入口。任意项目、任意机器同一个命令。
#   aiw <write|review|draft|seat> <workdir> <timeout_s> <prompt_file|-> [--ro] [--text] [--no-fallback] [--chain seat-a,seat-b] [--no-findings] [--attach 文件 ...] [--verify 命令 ...] [--verify-timeout 秒]   外包一单
#     prompt_file 写 - 时从标准输入读；--text 隐含 --ro；workspace 座位禁用工具；draft 自动启用
#   aiw off [30m|2h|3d|forever]  关闭派单（默认至本地次日零点）
#   aiw on                     恢复派单
#   aiw status                 查看派单开关
#   aiw rate <run> ok|fixed|rework|discard [--note 文本] | --pending [--days N] [--session ID]
#   aiw note <workdir> <现象> [--expected 文本] [--evidence 文本] [--location 文本]
#   aiw findings extract [--days N] | status  抽取信号 / 查看本机状态
#   aiw triage start [--days N] | apply <decisions.json> | abort
#   aiw track [--host 名称] [--timeout 秒] <标签> -- <命令> [参数...]  登记主会话长任务
#   aiw slot [--slots N] [--max-wait 秒] [--label 文本] -- <命令> [参数...] | --status  测试排队
#   aiw errand <子命令> ...  跑腿专线（云端真实执行，需用户弹窗确认）
#   aiw enable <seat|provider:model>  用户确认仍免费后恢复单条停用记录
#   aiw freecheck [--install|--uninstall]  免费检查 / 每日 09:30 定时任务
#   aiw doctor [--fingerprint] 检查各座位 CLI 安装/版本/熔断
#   aiw panel <workdir> <timeout_s> <prompt_file> [seat ...] [--attach 文件 ...] [--free]   同时问几家，收齐独立意见
#   aiw map <workdir> <timeout_s> <prompt_file> <文件 ...> [--seat 座位] [--jobs N]   逐文件并行派单
#   aiw flow run <流程文件> [--resume <流水目录>] | aiw flow status <流水目录>   多步流水线（并行→逐条→汇总，可续跑）
#   aiw handoff --template | --path | <交接文件> [--workdir DIR] [--dry-run]
#   aiw route "消息"            看这条消息会派给谁
#   aiw goal init|next|verify|status <goal.json>
#   aiw board [--all] [--session id] [--once] [--interval 2] [--recent 15]
#     board 转发到 aiw-board
#   aiw statusline              转发到 aiw-board statusline
#   aiw tui [codex 参数...]     在 tmux 底栏显示本会话派单摘要
#   aiw tokens [天数=7] [--json] [--top N=10] [--phases]  只读 token 测量
#   aiw weekly [days] [--json]  本机周报
#   aiw snapshot               写本机脱敏快照到 snapshots/<host>.json（用于两台机器查漂移）
#   aiw gc [天数] [--dry-run]   清理旧 runs/panels/maps（默认 30 天）
#   aiw sync                   先 git pull --ff-only 更新 aiw，再更新已安装的 agent-use 和 agent-use-adapters（后两者失败只警告）
set -euo pipefail
# 解析软链，找到仓库目录（兼容 macOS 自带 bash 3.2，不用 readlink -f）
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="${dir}/${src}" ;; esac
done
H="$(cd -P "$(dirname "$src")/.." && pwd)"
PY="${AIW_PYTHON:-python3}"

cmd="${1:-help}"
# 所有子命令（含 shell 转发）共用一次解释器检查。
if ! "$PY" -c 'import sys
if sys.version_info < (3, 11):
    message = "当前 Python " + sys.version.split()[0] + "，需要 Python 3.11 及以上；可用 AIW_PYTHON 指定解释器"
    if sys.argv[1] == "doctor":
        print("  ✗ Python 版本：" + message)
    print(message, file=sys.stderr)
    sys.exit(1)' "$cmd"; then
  exit 1
fi
case "$cmd" in
  off|on|status) shift; exec "$PY" "${H}/dispatch.py" "$cmd" "$@" ;;
  rate) shift; exec "$PY" "${H}/rating.py" "$@" ;;
  note) shift; exec "$PY" "${H}/findings.py" note "$@" ;;
  findings) shift; exec "$PY" "${H}/findings.py" "$@" ;;
  triage) shift; exec "$PY" "${H}/triage.py" "$@" ;;
  track) shift; exec "$PY" "${H}/track.py" "$@" ;;
  slot) shift; exec "$PY" "${H}/slot.py" "$@" ;;
  errand)
    shift
    if [ "${AIW_NESTED:-}" = 1 ]; then
      echo '已在被外包的会话里，不得发起跑腿任务（aiw errand）' >&2
      exit 64
    fi
    ERRAND_HOME="$(PYTHONPATH="$H${PYTHONPATH:+:$PYTHONPATH}" "$PY" -c 'from ai_worker import errand_home; print(errand_home() or "")')"
    if [ -z "$ERRAND_HOME" ]; then
      echo '未配置跑腿：设置 AGENT_USE_ERRAND_HOME 或本地配置 errand.home' >&2
      exit 1
    fi
    if [ ! -f "$ERRAND_HOME/scripts/errand_use.py" ]; then
      echo "跑腿入口不存在：$ERRAND_HOME/scripts/errand_use.py" >&2
      exit 1
    fi
    exec "$PY" "$ERRAND_HOME/scripts/errand_use.py" "$@"
    ;;
  freecheck) shift; exec "$PY" "${H}/freecheck.py" "$@" ;;
  enable)   shift; exec "$PY" "${H}/ai_worker.py" enable "$@" ;;
  doctor)   shift; exec "$PY" "${H}/ai_worker.py" doctor "$@" ;;
  handoff)  shift; exec "$PY" "${H}/handoff.py" "$@" ;;
  route)    shift; exec "$PY" "${H}/route.py" "$@" ;;
  panel)    shift; exec "$PY" "${H}/panel.py" "$@" ;;
  map)      shift; exec "$PY" "${H}/map.py" "$@" ;;
  flow)     shift; exec "$PY" "${H}/flow.py" "$@" ;;
  goal)     shift; exec "$PY" "${H}/goal.py" "$@" ;;
  tui)      shift; exec "$PY" "${H}/tui.py" launch "$@" ;;
  tui-status) shift; exec "$PY" "${H}/tui.py" status "$@" ;;
  board|statusline)
    shift
    if command -v aiw-board >/dev/null 2>&1; then
      if [ "$cmd" = statusline ]; then
        exec aiw-board statusline "$@"
      fi
      exec aiw-board "$@"
    fi
    echo '未安装 aiw-board（可选组件）：见 https://github.com/Jerryx333/aiw-board ，安装后确保 aiw-board 在 PATH 中' >&2
    exit 127
    ;;
  tokens)   shift; exec "$PY" "${H}/tokens.py" "$@" ;;
  weekly)   shift; exec "$PY" "${H}/weekly.py" "$@" ;;
  snapshot) exec "$PY" "${H}/snapshot.py" ;;
  gc)       shift; exec "$PY" "${H}/gc.py" "$@" ;;
  sync)
    source "${H}/agent_use_setup.sh"
    aiw_git -C "${H}" pull --ff-only
    aiw_agent_use_paths
    if aiw_is_git_repo "$AU" && ! aiw_pull_optional "$AU" agent-use; then
      echo '核心更新失败，跳过适配器更新以免版本错配'
    elif aiw_is_git_repo "$ADAPTERS"; then
      aiw_pull_optional "$ADAPTERS" agent-use-adapters || :
    fi
    exit 0
    ;;
  help|-h|--help) sed -n '2,/^set -euo pipefail/{ /^#/p; }' "$0" | sed 's/^# \{0,1\}//' ;;
  *)        exec "$PY" "${H}/ai_worker.py" "$@" ;;
esac
